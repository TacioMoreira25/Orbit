{
  "name": "@orbit/server",
  "version": "1.0.0",
  "description": "Orbit - High performance local network file and clipboard sync server for Linux",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "benchmark": "tsx scripts/benchmark-1gb.ts"
  },
  "keywords": [
    "file-transfer",
    "clipboard-sync",
    "fastify",
    "streams",
    "websocket",
    "sha256",
    "zeroconf"
  ],
  "author": "Orbit Team",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/websocket": "^10.0.1",
    "bonjour-service": "^1.2.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
